# Copia este archivo como .env y llena los valores. .env nunca va al repositorio.
# Proveedor principal: groq, gemini u ollama (local, sin llave).
LLM_PROVIDER=
LLM_API_KEY=
# Opcional: modelo. Vacío = el verificado en producto/proveedor.py (MODELOS_POR_DEFECTO).
LLM_MODEL=
# Opcional: respaldo. Vacío = otro modelo del mismo proveedor.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# true = sin internet: solo Ollama local.
OFFLINE_MODE=false
